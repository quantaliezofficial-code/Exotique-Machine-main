{
  "name": "luxura-motors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "backend": "python run_backend.py",
    "fastapi": "python run_backend.py",
    "fastapi:test": "python -m pytest backend/test_backend.py -v",
    "server": "python run_backend.py",
    "server:node": "node server/index.js",
    "start": "python run_backend.py",
    "build": "tsc --noEmit && vite build",
    "build:hostinger": "node build-hostinger.js",
    "import:vehicles": "python scripts/import_vehicles.py",
    "import:dry-run": "python scripts/import_vehicles.py --dry-run",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "docx": "^9.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
