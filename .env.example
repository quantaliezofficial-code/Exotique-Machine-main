# ========================================================
# Exotique Machines / Luxura - Environment Configuration
# ========================================================

# FastAPI Backend Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False

# PostgreSQL Database Configuration
# Replace 'your_postgres_password' with your PostgreSQL master password.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/luxura_db

# Granular PostgreSQL Settings (used by auto-creation helper)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=luxura_db

# Graceful SQLite fallback if PostgreSQL service is offline or credentials unconfigured
FALLBACK_TO_SQLITE=True

# JWT Authentication Secret
JWT_SECRET=exotique_machines_jwt_secret_token_key_2026

# Superadmin Initial Password Setup
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_NAME=Master Super Admin
