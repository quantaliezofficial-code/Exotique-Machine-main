# Exotique Machines — backend configuration (copy to .env and fill in).
# Never commit .env. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production
SITE_URL=https://exotiquemachines.com

# PostgreSQL (container/host name on the exotique_network)
DATABASE_URL=postgresql+psycopg2://exotique:CHANGE_ME@postgres:5432/luxura_db
FALLBACK_TO_SQLITE=false

# Session signing key: random, at least 32 characters. Changing it signs everyone out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRES_HOURS=12
COOKIE_SECURE=true

# First super admin (only used if none exists, or to rotate one still on a published
# default password). 10+ characters, mixing three of: lower, upper, digits, symbols.
SUPERADMIN_USERNAME=owner
SUPERADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_NAME=Showroom Owner

# Uploads
MAX_UPLOAD_MB=25
EAGER_IMAGE_VARIANTS=true

# Logging: json (production) or text
LOG_FORMAT=json
SLOW_REQUEST_MS=800

# Only for local tooling; the site and API are same-origin.
CORS_ORIGINS=
ENABLE_API_DOCS=false
